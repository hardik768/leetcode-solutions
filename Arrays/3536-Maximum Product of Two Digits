/*
Problem: 3536-Maximum Product of Two Digits
Difficulty: Easy

Time Complexity: O(d logd)
Space Complexity: O(d)
where d is digit of number 
*/
code:
class Solution {
public:
    int maxProduct(int n) {
        vector <int> result;
        while(n>0){
            int digit=n%10;
            result.push_back(digit);
            n/=10;
        }
        sort(result.begin(),result.end());
        return result[result.size()-1]* result[result.size()-2];
        
    }
};
