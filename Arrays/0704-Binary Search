/*
Problem: 0704. Binary Search
Difficulty: Easy

Time Complexity: O(log n)
Space Complexity: O(1)

Approach:
1) start from the middle value instead of using transversal method
2) compare middle value whether it is large or smaller than the target element 
3) it always works in sorted array only 
*/
# Code
```cpp []
class Solution {
public:
    int search(vector<int>& nums, int target) {
        int left=0;
        int right=nums.size()-1;
        while(left<=right){
            int mid=left+(right-left)/2;
            if(nums[mid]==target){
                return mid;}
            else if (nums[mid]<target){
                left=mid+1;
            }
            else{
                right=mid-1;
            }    
        }
        return -1;
    }
};
```
