/*
Problem: 392. Is Subsequence
Difficulty: Easy

Time Complexity: O(n)
Space Complexity: O(n)
*/
class Solution {
public:
    bool isSubsequence(string s, string t) {
        string copy="";
        int left=0;
        int right=0;
        while(right<t.size()){
            if(s[left]==t[right]){
                copy+=t[right];
                left++;
                right++;

            }
            else{
                right++;
            }
        }
        return copy==s;
    }
};
