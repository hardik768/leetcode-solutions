/*
Problem: 2535. Difference Between Element Sum and Digit Sum of an Array
Difficulty: Easy

Time Complexity: O(n)
Space Complexity: O(1)

Approach:
*/
class Solution {
public:
    int differenceOfSum(vector<int>& nums) {
        int sum=0;
        int digit=0;
        for(int i=0;i<nums.size();i++){
            sum+=nums[i];
        }
        for(int i=0;i<nums.size();i++){
            while(nums[i]>0){
                digit+=nums[i]%10;
                nums[i]/=10;
            }
        }
        return abs(sum-digit);
    }
};
