/*
Problem: 3925-Concatenate Array With Reverse
Difficulty: Easy

Time Complexity: O(n)
Space Complexity: O(n)

Approach:
1) create an array and then add element in serial number
2) after that add element reverse order to same array using pushback library
*/
class Solution {
public:
    vector<int> concatWithReverse(vector<int>& nums) {
        int n=nums.size();
        vector<int> ans;
        for(int i=0;i<n;i++){
            ans.push_back(nums[i]);   
        }
        for(int i=n-1;i>=0;i--){
            ans.push_back(nums[i]);
        }
        return ans;
    }
};
