/*
Problem: 1662. Check If Two String Arrays are Equivalent
Difficulty: Easy

Time Complexity: O(n)
Space Complexity: O(1)

Approach:
take two strings and concatenate all the element of word1 and word2.
*/
class Solution {
public:
    bool arrayStringsAreEqual(vector<string>& word1, vector<string>& word2) {
        string w1,w2;
        for(string i:word1){
            w1+=i;
        }
        for(string i:word2){
            w2+=i;
        }
        return w1==w2;
    }
};
