/*
Problem: 344. Reverse String
Difficulty: Easy

Time Complexity: O(n)
Space Complexity: O(1)

Approach:
Reverse an array in-place using two pointers moving from ends to center.
*/
class Solution {
public:
    void reverseString(vector<char>& s) {
        int left=0;
        int right=s.size()-1;
        while(left<=right){
            swap(s[left],s[right]);
            left++;
            right--;
        }
    }
};
